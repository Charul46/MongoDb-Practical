db.orders.aggregate([
    {
        $group: {
            _id: "$status",
            count: { $sum: 1 }
        }
    },
    {
        $sort: { count: -1 }
    }
]);

db.orders.aggregate([
    {
        $match: {
            status: "delivered"
        }
    },
    {
        $project: {
            _id: 0,
            customer: 1,
            item: 1,
            qty: 1
        }
    }
]);

db.orders.aggregate([
    {
        $match: {
            status: "delivered"
        }
    },
    {
        $group: {
            _id: "$item",
            totalQty: { $sum: "$qty" },
            revenue: {
                $sum: {
                    $multiply: ["$qty", "$price"]
                }
            }
        }
    },
    {
        $sort: {
            revenue: -1
        }
    }
]);

db.orders.aggregate([
    {
        $match: {
            status: "delivered"
        }
    },
    {
        $group: {
            _id: "$customer",
            orders: { $sum: 1 },
            totalSpend: {
                $sum: {
                    $multiply: ["$qty", "$price"]
                }
            }
        }
    },
    {
        $project: {
            _id: 0,
            customer: "$_id",
            orders: 1,
            totalSpend: 1
        }
    },
    {
        $sort: {
            totalSpend: -1
        }
    }
]);

db.orders.aggregate([
    {
        $match: {
            status: "delivered"
        }
    },
    {
        $group: {
            _id: "$customer",
            totalSpend: {
                $sum: {
                    $multiply: ["$qty", "$price"]
                }
            }
        }
    },
    {
        $sort: {
            totalSpend: -1
        }
    },
    {
        $limit: 1
    },
    {
        $project: {
            _id: 1,
            totalSpend: 1
        }
    }
]);